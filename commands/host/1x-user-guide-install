#!/usr/bin/env bash

## #ddev-generated
## Description: Set up the end-user guide (docs/user-guide/ on GitLab Pages): prepare the project, establish what is wanted (Claude Code asks), store it, apply it (CI, Pages settings, site.config.json)
## Usage: 1x-user-guide-install [prepare|establish|store|show|apply] [--manifest <file>] [--yes] [--dry-run]
## Example: "ddev 1x-user-guide-install" (prepare, then establish or apply), "ddev 1x-user-guide-install --manifest facts.json" (no Claude Code), "ddev 1x-user-guide-install apply --dry-run" (shows every change, writes nothing)

# One command, in phases. Idempotent: every step skips what is already in place.
#   prepare:   local and mechanical. Checks, agents package, content folder, screenshot runner, first build.
#   establish: Claude Code finds the facts and asks the decisions (publish strategy, URLs, branding, Pages use).
#   store:     the facts go into docs/user-guide/setup.json through this command, which validates them.
#   apply:     deterministic. Shows a diff, asks before writing, asks before changing the GitLab project.
# With no subcommand: prepare, then apply when facts (or --manifest) exist, otherwise establish.
# Claude Code never edits .gitlab-ci.yml or calls the GitLab API for this; it only produces facts.
set -euo pipefail

source "${BASH_SOURCE%/*}/1x-lib.sh"

ORIG_PWD="${PWD}"
cd "${DDEV_APPROOT}"

fail() { echo -e "${RED}✗ $*${NC}" >&2; exit 1; }
ok() { echo -e "${GREEN}✓${NC} $*"; }
note() { echo -e "${YELLOW}!${NC} $*"; }
step() { echo -e "\n${CYAN}$*${NC}"; }

GUIDE="docs/user-guide"
FACTS="${GUIDE}/setup.json"
SITE="${GUIDE}/site.config.json"
CI_FILE=".gitlab-ci.yml"
INCLUDE_PROJECT="1xinternet/gitlab-ci-common"
INCLUDE_FILE="gitlab-pages.yml"

SUB=""
YES=0
DRY=0
MANIFEST=""
while [ $# -gt 0 ]; do
  case "$1" in
    --yes) YES=1 ;;
    --dry-run) DRY=1 ;;
    --manifest) MANIFEST="${2:-}"; [ -n "${MANIFEST}" ] || fail "--manifest needs a file."; shift ;;
    --manifest=*) MANIFEST="${1#--manifest=}" ;;
    prepare|establish|store|show|apply) SUB="$1" ;;
    *) sed -n '4,6p' "$0"; exit 1 ;;
  esac
  shift
done
INTERACTIVE=0
[ -t 0 ] && INTERACTIVE=1

confirm() { # confirm "question" -> 0 on yes; never in a non-interactive terminal
  [ "${INTERACTIVE}" = 1 ] || return 1
  local answer
  read -r -p "$1 [y/N] " answer
  [[ "${answer}" =~ ^[yY]([eE][sS])?$ ]]
}


# --- validation (used by store, and again by apply) --------------------------------------
validate() { # validate < json -> prints errors, one per line
  jq_compat -r '
    def url: type == "string" and test("^https?://[^ ]+$");
    def relpath: type == "string" and (startswith("/") | not) and (contains("..") | not);
    [
      (if .version != 1 then "version must be 1" else empty end),
      (if ((.publish // "") | test("^(tags|branch:[^ ]+)$")) then empty else "publish must be \"tags\" or \"branch:<name>\"" end),
      (if ((.pages // "own") | IN("own", "existing")) then empty else "pages must be \"own\" or \"existing\"" end),
      ((.sites // [])[] | select(((.name // "") | type != "string" or . == "") or ((.url // "") | url | not)) | "invalid site (needs name and http(s) url): \(tojson)"),
      (if (.branding.accent // "#000") | test("^#[0-9a-fA-F]{3,8}$") then empty else "branding.accent must be a hex colour like #e30613" end),
      ((.branding.logo, .branding.favicon) | select(. != null) | select(relpath | not) | "branding paths must be relative to the project root and not contain ..: \(.)")
    ] | .[]' 2>&1
}
check_assets() { # files named in the facts must exist
  local f
  for f in $(jq_compat -r '(.branding.logo, .branding.favicon) | select(. != null)' < "$1"); do
    [ -f "${f}" ] || echo "branding file not found: ${f}"
  done
}

# A manifest is checked first, before anything slow or with side effects runs.
if [ -n "${MANIFEST}" ]; then
  case "${MANIFEST}" in /*) ;; *) MANIFEST="${ORIG_PWD}/${MANIFEST}" ;; esac
  [ -f "${MANIFEST}" ] || fail "Manifest not found: ${MANIFEST}"
  EARLY_ERRORS="$( { validate < "${MANIFEST}"; check_assets "${MANIFEST}"; } | sed '/^$/d')"
  if [ -n "${EARLY_ERRORS}" ]; then
    echo -e "${RED}✗ The manifest is not valid:${NC}" >&2; echo "${EARLY_ERRORS}" | sed 's/^/  - /' >&2; exit 1
  fi
fi

# ==== prepare ============================================================================
# Not on a dry run (it changes things), and not for an explicit store/show/apply/establish.
if [ "${SUB}" = "prepare" ] || { [ -z "${SUB}" ] && [ "${DRY}" = 0 ]; }; then
PROMOTED_PACKAGE="git@git.1xinternet.de:1x-agents/packages/user-guide.git"
CUSTOM_PACKAGE="git@git.1xinternet.de:1x-agents/packages/custom/user-guide.git"
SKILL=".agent/skills/user-guide"

step "Prepare 1/5 Checks"
git rev-parse --git-dir > /dev/null 2>&1 || fail "Not a git repository."
REMOTE="$(git remote get-url origin 2>/dev/null)" || fail "No git remote 'origin'."
case "${REMOTE}" in
  *git.1xinternet.de*) ;;
  *) fail "origin is not on git.1xinternet.de (${REMOTE}); GitLab Pages needs the project there." ;;
esac
git ls-remote origin HEAD > /dev/null 2>&1 \
  || fail "GitLab is not reachable over SSH. Connect the VPN and check: ssh -T git@git.1xinternet.de"
ok "GitLab reachable"
[ -f .1xai-manifest.json ] || fail "No .1xai-manifest.json: install 1x-ai in this project first (npx @1xINTERNET/1x-ai@latest)."
command -v npx > /dev/null 2>&1 || fail "npx not found on the host: install Node.js."
ddev drush php:eval "echo 1;" > /dev/null 2>&1 \
  || fail "The local site doesn't run (drush fails). Usually the database belongs to another branch: import a fresh one or run 'ddev drush deploy', then run this again."
ok "Local site runs"
if ! ddev 1x-playwright --version > /dev/null 2>&1 || [ ! -f test/playwright/playwright.config.ts ]; then
  fail "Playwright is not set up: run 'ddev 1x-token-setup' and 'ddev 1x-playwright-install', then run this again."
fi
ok "Playwright set up"

step "Prepare 2/5 Agents package"
# Prefer the promoted package once it exists; replace a line for the other repo or for a branch.
if git ls-remote "${PROMOTED_PACKAGE}" HEAD > /dev/null 2>&1; then
  PACKAGE="${PROMOTED_PACKAGE}"
else
  PACKAGE="${CUSTOM_PACKAGE}"
fi
CURRENT="$(jq_compat -r --arg p "${PACKAGE}" '.packages[$p] // ""' < .1xai-manifest.json)"
if [ "${CURRENT}" != "HEAD" ]; then
  jq_compat --arg a "${PROMOTED_PACKAGE}" --arg b "${CUSTOM_PACKAGE}" --arg p "${PACKAGE}" \
    '.packages |= (del(.[$a], .[$b]) + {($p): "HEAD"})' < .1xai-manifest.json > .1xai-manifest.json.tmp
  mv .1xai-manifest.json.tmp .1xai-manifest.json
  ok "Added ${PACKAGE} to .1xai-manifest.json"
else
  ok "Package already in .1xai-manifest.json"
fi
npx --yes @1xINTERNET/1x-ai@latest . update > /dev/null
[ -f "${SKILL}/SKILL.md" ] || fail "The user-guide skill was not installed (${SKILL}). Run 'npx @1xINTERNET/1x-ai@latest . update' and check its output."
ok "user-guide skill installed"

step "Prepare 3/5 Content folder"
# Pages URL from the GitLab path: group/sub/project -> https://group.pages.1xinternet.de/sub/project/
GITLAB_PATH="$(echo "${REMOTE}" | sed -E 's#^(ssh://)?(git@|https://)git\.1xinternet\.de[:/]##; s#\.git$##')"
PAGES_URL="https://${GITLAB_PATH%%/*}.pages.1xinternet.de/${GITLAB_PATH#*/}/"
mkdir -p "${GUIDE}"
if [ ! -f "${GUIDE}/site.config.json" ]; then
  jq_compat -n --arg title "${DDEV_PROJECT} user guide" --arg url "${PAGES_URL}" --arg local "${DDEV_PRIMARY_URL}" \
    '{title: $title, description: "How to work with the website.", url: $url, sites: [{name: "Local", url: $local}]}' \
    > "${GUIDE}/site.config.json"
  ok "Created ${GUIDE}/site.config.json (${PAGES_URL})"
else
  ok "${GUIDE}/site.config.json exists"
fi
if [ ! -f "${GUIDE}/index.md" ]; then
  cat > "${GUIDE}/index.md" <<EOF
---
title: ${DDEV_PROJECT} user guide
description: How to work with the website.
---

This guide explains how to work with the website.
EOF
  ok "Created ${GUIDE}/index.md"
else
  ok "${GUIDE}/index.md exists"
fi
# The preview is now 'ddev 1x-user-guide'; remove the copy the user-guide skill used to manage.
if [ -f .ddev/commands/host/user-guide ] && grep -q "MANAGED FILE" .ddev/commands/host/user-guide; then
  rm .ddev/commands/host/user-guide
  ok "Removed the old .ddev/commands/host/user-guide (now: ddev 1x-user-guide)"
fi

step "Prepare 4/5 Screenshot runner"
# The runner is a managed copy of the skill's asset; only an older managed version is replaced.
version() { sed -n 's/.*Version \([0-9][0-9]*\)\..*/\1/p' "$1" | head -1; }
ASSETS="${SKILL}/assets/playwright"
if [ ! -f test/playwright/playwright.user-guide.config.ts ]; then
  cp "${ASSETS}/playwright.user-guide.config.ts" test/playwright/
  ok "Added test/playwright/playwright.user-guide.config.ts"
fi
SPEC="test/playwright/user-guide/screenshots.spec.ts"
if [ ! -f "${SPEC}" ]; then
  mkdir -p "$(dirname "${SPEC}")"
  cp "${ASSETS}/user-guide/screenshots.spec.ts" "${SPEC}"
  ok "Added ${SPEC}"
elif head -1 "${SPEC}" | grep -q "MANAGED FILE"; then
  if [ "$(version "${SPEC}")" -lt "$(version "${ASSETS}/user-guide/screenshots.spec.ts")" ]; then
    cp "${ASSETS}/user-guide/screenshots.spec.ts" "${SPEC}"
    ok "Updated ${SPEC}"
  else
    ok "${SPEC} is up to date"
  fi
else
  note "${SPEC} is the project's own script; Claude Code moves its shots into screenshots.json."
fi
ddev 1x-playwright test -c playwright.user-guide.config.ts --pass-with-no-tests > /dev/null \
  || fail "The screenshot runner fails: ddev 1x-playwright test -c playwright.user-guide.config.ts --pass-with-no-tests"
ok "Screenshot runner works"

step "Prepare 5/5 Build"
ddev 1x-user-guide check > /dev/null || fail "The guide doesn't build: ddev 1x-user-guide check"
ok "Guide builds (ddev 1x-user-guide check)"
fi
if [ "${SUB}" = "prepare" ]; then
  echo -e "\n${GREEN}Prepared.${NC} Next: ddev 1x-user-guide-install (establish, store, apply)"
  exit 0
fi
[ -f "${SITE}" ] || fail "No user guide in this project yet. Run: ddev 1x-user-guide-install prepare"

# A manifest replaces step a): the same file Claude Code would have produced, validated and stored, then applied.
if [ -n "${MANIFEST}" ]; then
  case "${MANIFEST}" in /*) ;; *) MANIFEST="${ORIG_PWD}/${MANIFEST}" ;; esac
  [ -f "${MANIFEST}" ] || fail "Manifest not found: ${MANIFEST}"
  MERRORS="$( { validate < "${MANIFEST}"; check_assets "${MANIFEST}"; } | sed '/^$/d')"
  if [ -n "${MERRORS}" ]; then
    echo -e "${RED}✗ The manifest is not valid:${NC}" >&2; echo "${MERRORS}" | sed 's/^/  - /' >&2; exit 1
  fi
  if [ "${DRY}" = 1 ]; then
    FACTS="${MANIFEST}"
    note "Dry run: using ${MANIFEST}, not storing it."
  else
    [ "${MANIFEST}" -ef "${FACTS}" ] || cp "${MANIFEST}" "${FACTS}"
    ok "Stored ${MANIFEST} as ${FACTS}"
  fi
  SUB="apply"
fi
SUB="${SUB:-$([ -f "${FACTS}" ] && echo apply || echo establish)}"

# ==== a) establish =======================================================================
if [ "${SUB}" = "establish" ]; then
  PROMPT="You are setting up the end-user guide in this project (${GUIDE}/). ddev 1x-user-guide-install has prepared it. Your job here is only to establish facts and store them; a person applies them afterwards.

Find facts yourself (repo, .ddev/config.yaml, .gitlab-ci.yml, docs/STANDARDS.md, deploy job environment urls, the active frontend theme) and ask me only for decisions, in one round where possible. Establish:
1. publish: \"tags\" (release tags, what Prod has; only if the project has tags and a tag pipeline) or \"branch:<name>\" (e.g. main, what Stage has, or an MVP branch).
2. pages: \"own\" or \"existing\". If .gitlab-ci.yml already has a job named pages or a docs-ui include, ask whether to keep it; \"existing\" means the guide is only checked in CI.
3. sites: besides Local (already set): Stage (usually https://stage.<project>.de) and Prod (usually https://www.<project>.de); confirm from docs/STANDARDS.md or the deploy jobs and ask only for what no source confirms. No test environment; Qaack is not a preset.
4. branding (optional): title '<Project> user guide' with the real project name; logo (SVG with fixed fill colours, not currentColor), favicon (the largest PNG) and accent (the logo's brand colour) from the active frontend theme. Give paths relative to the project root; they are copied into ${GUIDE}/assets/ when applied. Ask only if there are several real candidates.

Store the facts by piping JSON to: ddev 1x-user-guide-install store
Schema (version 1): {\"version\":1,\"publish\":\"tags|branch:<name>\",\"pages\":\"own|existing\",\"sites\":[{\"name\":\"Stage\",\"url\":\"https://...\"}],\"branding\":{\"title\":\"...\",\"logo\":\"path\",\"favicon\":\"path\",\"accent\":\"#rrggbb\"}}
It validates and prints errors; fix and store again. Then run: ddev 1x-user-guide-install apply --dry-run, show me the output and stop. Do not run apply without --dry-run, do not edit .gitlab-ci.yml or ${SITE} by hand, and do not change anything on GitLab; applying is my decision.

When I tell you that apply is done, continue with the local content, state what you change before each step:
- STANDARDS: add the section 'End-user documentation' to docs/STANDARDS.md with the template in .agent/skills/user-guide/assets/standards-section.md. Ask me for readers, their roles and the language.
- Delete the Playwright scaffold's demo tests (test/playwright/tests/example.spec.ts, test/playwright/tests-examples/) if they are not tracked by git.
- First page, with the user-guide skill: ask me which single task a user of the website should be able to do; prefer one that needs a screenshot. Write the page, add it to index.md, take the screenshot with the runner (synthetic user, test content with a fixed UUID), check it for personal data, and give me the preview link (ddev 1x-user-guide).
- Finish: ddev 1x-user-guide check must end with 'User guide OK'; git status lists only the files of this setup (.claude/settings.json is never committed). Summarise what was done, list the changed files and propose commits. Don't commit, push or open a merge request until I say so."
  echo -e "${CYAN}a) Establish${NC}: Claude Code will look for the facts and ask you for the decisions: publish strategy, Pages use, Stage and Prod URLs, branding."
  echo "It stores them in ${FACTS} (validated) and stops before applying anything."
  command -v claude > /dev/null 2>&1 || { note "Claude Code is not installed. Write the facts yourself and run: ddev 1x-user-guide-install --manifest facts.json (the format is in the README)."; exit 0; }
  [ "${INTERACTIVE}" = 1 ] || { echo "Not an interactive terminal, not starting Claude Code. Run: ddev 1x-user-guide-install establish, or pass facts with --manifest <file>"; exit 0; }
  confirm "Start Claude Code now?" || { echo "Not started. Run it later with: ddev 1x-user-guide-install establish, or pass facts with: ddev 1x-user-guide-install --manifest <file>"; exit 0; }
  exec claude "${PROMPT}"
fi

# ==== b) store ===========================================================================
if [ "${SUB}" = "store" ]; then
  [ -t 0 ] && fail "Pipe the facts as JSON on stdin: ddev 1x-user-guide-install store < facts.json"
  TMP="$(mktemp)"; trap 'rm -f "${TMP}"' EXIT
  jq_compat . > "${TMP}" 2> /dev/null || fail "stdin is not valid JSON."
  ERRORS="$( { validate < "${TMP}"; check_assets "${TMP}"; } | sed '/^$/d')"
  if [ -n "${ERRORS}" ]; then
    echo -e "${RED}✗ The facts are not valid:${NC}" >&2
    echo "${ERRORS}" | sed 's/^/  - /' >&2
    exit 1
  fi
  if [ "${DRY}" = 1 ]; then ok "Valid (dry run, not stored)"; exit 0; fi
  cp "${TMP}" "${FACTS}"
  ok "Stored in ${FACTS}"
  echo "Next: ddev 1x-user-guide-install apply   (shows every change first)"
  exit 0
fi

# ==== show / apply need facts ============================================================
[ -f "${FACTS}" ] || fail "No facts yet (${FACTS}). Run: ddev 1x-user-guide-install establish"
ERRORS="$( { validate < "${FACTS}"; check_assets "${FACTS}"; } | sed '/^$/d')"
[ -z "${ERRORS}" ] || { echo -e "${RED}✗ ${FACTS} is not valid:${NC}" >&2; echo "${ERRORS}" | sed 's/^/  - /' >&2; exit 1; }

PUBLISH="$(jq_compat -r '.publish' < "${FACTS}")"
PAGES="$(jq_compat -r '.pages // "own"' < "${FACTS}")"
BRANCH=""
case "${PUBLISH}" in branch:*) BRANCH="${PUBLISH#branch:}" ;; esac

summary() {
  echo "  publish:  ${PUBLISH}"
  echo "  pages:    ${PAGES}"
  jq_compat -r '(.sites // [])[] | "  site:     \(.name) \(.url)"' < "${FACTS}"
  jq_compat -r '.branding // {} | to_entries[] | "  branding: \(.key) = \(.value)"' < "${FACTS}"
}

if [ "${SUB}" = "show" ]; then
  echo "Facts in ${FACTS}:"; summary; exit 0
fi

# ==== c) apply ===========================================================================
REMOTE="$(git remote get-url origin 2>/dev/null)" || fail "No git remote 'origin'."
case "${REMOTE}" in *git.1xinternet.de*) ;; *) fail "origin is not on git.1xinternet.de (${REMOTE})." ;; esac
GITLAB_PATH="$(echo "${REMOTE}" | sed -E 's#^(ssh://)?(git@|https://)git\.1xinternet\.de[:/]##; s#\.git$##')"

echo -e "${CYAN}c) Apply${NC} the facts in ${FACTS}:"; summary

NEW_CI="$(mktemp)"; NEW_SITE="$(mktemp)"
trap 'rm -f "${NEW_CI}" "${NEW_CI}.out" "${NEW_SITE}"' EXIT
# bash 3.2 (macOS) has no associative arrays and the helper needs plain files: keep the edits in temp files.

step "1/3 ${CI_FILE}"
if [ -f "${CI_FILE}" ]; then cp "${CI_FILE}" "${NEW_CI}"; else echo "stages: [test, deploy]" > "${NEW_CI}"; note "No ${CI_FILE}; a new one is created."; fi
if grep -q "${INCLUDE_FILE}" "${NEW_CI}"; then
  ok "${CI_FILE} already includes ${INCLUDE_FILE}"
else
  # Another job already using the Pages site: only a fact ("existing") makes this safe.
  if [ "${PAGES}" = "own" ] && { [ "$(yq_compat '.pages // "" | length' < "${NEW_CI}")" != "0" ] || grep -qi "docs-ui" "${NEW_CI}"; }; then
    fail "${CI_FILE} already has a 'pages' job or a docs-ui include, but the facts say pages: own. Decide, then set pages to \"existing\" (keep it, only check the guide) in ${FACTS}, or remove the old job by hand."
  fi
  # include may be missing, a string, a map or a list: normalise to a list, then append.
  yq_compat ".include = ([.include] | flatten | map(select(. != null))) + [{\"project\": \"${INCLUDE_PROJECT}\", \"file\": \"${INCLUDE_FILE}\"}]" < "${NEW_CI}" > "${NEW_CI}.out"
  mv "${NEW_CI}.out" "${NEW_CI}"
fi
if [ -n "${BRANCH}" ]; then
  yq_compat ".variables.GITLAB_PAGES_BRANCH = \"${BRANCH}\"" < "${NEW_CI}" > "${NEW_CI}.out"; mv "${NEW_CI}.out" "${NEW_CI}"
fi
if [ "${PAGES}" = "existing" ]; then
  yq_compat '.variables.GITLAB_PAGES_ENABLED = "false"' < "${NEW_CI}" > "${NEW_CI}.out"; mv "${NEW_CI}.out" "${NEW_CI}"
fi

# Stages: the template's jobs run in .post, and GitLab creates no pipeline with only .pre/.post jobs.
# Ask GitLab how the merged pipeline looks for the publish ref; if it would be empty, give the jobs real stages.
PROJECT_ID=""
if command -v glab > /dev/null 2>&1; then
  PROJECT_ID="$(glab api "projects/$(jq_compat -rn --arg p "${GITLAB_PATH}" '$p|@uri')" 2> /dev/null | jq_compat -r '.id // empty' || true)"
fi
if [ -n "${PROJECT_ID}" ]; then
  # For tags there is no branch to lint: use the current branch, or the project's default branch.
  REF="${BRANCH:-$(git symbolic-ref --short -q HEAD || true)}"
  [ -n "${REF}" ] || REF="$(glab api "projects/${PROJECT_ID}" 2> /dev/null | jq_compat -r '.default_branch // "main"' || echo main)"
  LINT="$(jq_compat -n --rawfile c "${NEW_CI}" --arg ref "${REF}" '{content: $c, dry_run: true, include_jobs: true, ref: $ref}' \
    | glab api -X POST "projects/${PROJECT_ID}/ci/lint" -H "Content-Type: application/json" --input - 2> /dev/null || true)"
  # An empty pipeline comes back as invalid ("would have been empty"); that is the case the override is for.
  LINT_EMPTY="$(echo "${LINT:-}" | jq_compat -r '(.errors // []) | map(select(test("would have been empty"))) | length' 2> /dev/null || echo 0)"
  if [ -n "${LINT}" ] && { [ "$(echo "${LINT}" | jq_compat -r '.valid // false')" = "true" ] || [ "${LINT_EMPTY}" != "0" ]; }; then
    if [ "${LINT_EMPTY}" != "0" ]; then REAL_JOBS=0
    else REAL_JOBS="$(echo "${LINT}" | jq_compat '[.jobs[]? | select(.stage != ".pre" and .stage != ".post")] | length')"; fi
    if [ "${REAL_JOBS}" = "0" ]; then
      if [ "$(yq_compat '.stages | length' < "${NEW_CI}")" = "0" ]; then CHECK_STAGE="test"; PAGES_STAGE="deploy"; else
        CHECK_STAGE="$(yq_compat '.stages | (map(select(. == "test")) + .) | .[0]' < "${NEW_CI}")"
        PAGES_STAGE="$(yq_compat '.stages | (map(select(. == "deploy")) + (. | reverse)) | .[0]' < "${NEW_CI}")"
      fi
      yq_compat ".\"user-guide:check\".stage = \"${CHECK_STAGE}\" | .pages.stage = \"${PAGES_STAGE}\"" < "${NEW_CI}" > "${NEW_CI}.out"; mv "${NEW_CI}.out" "${NEW_CI}"
      note "The pipeline would be empty (only .pre/.post jobs): user-guide:check runs in '${CHECK_STAGE}', pages in '${PAGES_STAGE}'."
    else
      ok "The merged pipeline has jobs outside .pre/.post, no stage override needed"
    fi
  elif [ -n "${LINT}" ]; then
    fail "GitLab reports the resulting CI config as invalid: $(echo "${LINT}" | jq_compat -r '.errors // [] | join("; ")'). Nothing applied."
  else
    note "Could not run the CI lint dry run (VPN or permissions); the stage check is skipped."
  fi
else
  note "glab not found or the project is not reachable; the stage check is skipped."
fi
for job in .user-guide-build user-guide:check; do
  [ -f "${CI_FILE}" ] && grep -q "^${job}:" "${CI_FILE}" && note "${CI_FILE} defines '${job}' itself; check whether it is an old copy of the guide job."
done
[ -d tools/user-guide-site ] && note "tools/user-guide-site/ is the old guide site; remove it if the guide moved to ${GUIDE}/."

step "2/3 ${SITE}"
# Local stays first; Stage, Prod and the like come from the facts. Branding keys are only set when given.
jq_compat --slurpfile f "${FACTS}" '
  ($f[0]) as $facts
  | .sites = ((.sites // [] | map(select(.name == "Local"))) + ($facts.sites // []))
  | (if $facts.branding.title then .title = $facts.branding.title else . end)
  | (if $facts.branding.logo then .logo = "assets/" + ($facts.branding.logo | split("/") | last) else . end)
  | (if $facts.branding.favicon then .favicon = "assets/" + ($facts.branding.favicon | split("/") | last) else . end)
  | (if $facts.branding.accent then .accent = $facts.branding.accent else . end)' < "${SITE}" > "${NEW_SITE}"
ASSETS_TO_COPY="$(jq_compat -r '(.branding.logo, .branding.favicon) | select(. != null)' < "${FACTS}")"

SOMETHING=0
for pair in "${CI_FILE}:${NEW_CI}" "${SITE}:${NEW_SITE}"; do
  cur="${pair%%:*}"; new="${pair#*:}"
  if [ -f "${cur}" ] && diff -q "${cur}" "${new}" > /dev/null; then ok "${cur} needs no changes"; continue; fi
  SOMETHING=1
  echo "Changes to ${cur}:"
  if [ -f "${cur}" ]; then diff -u --label "${cur}" --label "${cur} (new)" "${cur}" "${new}" || true; else cat "${new}"; fi
done
for a in ${ASSETS_TO_COPY}; do
  [ -f "${GUIDE}/assets/$(basename "${a}")" ] && cmp -s "${a}" "${GUIDE}/assets/$(basename "${a}")" || { SOMETHING=1; echo "Copy ${a} -> ${GUIDE}/assets/$(basename "${a}")"; }
done
if [ "${SOMETHING}" = 1 ]; then
  if [ "${DRY}" = 1 ]; then note "Dry run, nothing written."
  elif [ "${YES}" = 1 ] || confirm "Write these files?"; then
    cp "${NEW_CI}" "${CI_FILE}"; cp "${NEW_SITE}" "${SITE}"
    for a in ${ASSETS_TO_COPY}; do mkdir -p "${GUIDE}/assets"; cp "${a}" "${GUIDE}/assets/"; done
    ok "Written (review with git diff)"
  else
    note "Nothing written."
  fi
fi

step "3/3 GitLab Pages settings"
if [ -z "${PROJECT_ID}" ]; then
  note "Cannot reach the GitLab project with glab (install glab, connect the VPN, glab auth login). Check by hand: Deploy > Pages: 'Use unique domain' off, access: members only."
else
  LEVEL="$(glab api "projects/${PROJECT_ID}" | jq_compat -r '.pages_access_level // "unknown"')"
  if [ "${LEVEL}" = "private" ]; then
    ok "Pages access level is private (project members only)"
  else
    note "Pages access level is '${LEVEL}'; the guide must be for project members only."
    if [ "${DRY}" = 1 ]; then note "Dry run: would ask to set pages_access_level=private on ${GITLAB_PATH}."
    elif confirm "Set pages_access_level=private on GitLab project ${GITLAB_PATH}?"; then
      glab api -X PUT "projects/${PROJECT_ID}" -f pages_access_level=private > /dev/null
      ok "pages_access_level set to private"
    else
      note "Not changed. Set it in GitLab under Settings > General > Visibility > Pages."
    fi
  fi
  PAGES_JSON="$(glab api "projects/${PROJECT_ID}/pages" 2> /dev/null || true)"
  if [ -z "${PAGES_JSON}" ]; then
    note "No Pages deployment yet. After the first deploy check Deploy > Pages: 'Use unique domain' must be off."
  elif [ "$(echo "${PAGES_JSON}" | jq_compat -r '.is_unique_domain_enabled // false')" = "true" ]; then
    note "'Use unique domain' is on: turn it off in GitLab under Deploy > Pages, then run this again."
  else
    ok "'Use unique domain' is off"
  fi
fi

echo -e "\nNext: git diff, then tell Claude Code that apply is done (STANDARDS, first page), or: ddev 1x-user-guide check"
