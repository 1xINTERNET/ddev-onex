#!/usr/bin/env bash

## #ddev-generated
## Description: Prepare this project for the end-user guide (docs/user-guide/ on GitLab Pages): checks, agents package, content folder, screenshot runner. Claude Code does the rest.
## Usage: 1x-user-guide-install
## Example: "ddev 1x-user-guide-install"

# Idempotent: every step skips what is already in place, so it can run again after fixing a failed check.
set -euo pipefail

source "${BASH_SOURCE%/*}/1x-lib.sh"

cd "${DDEV_APPROOT}"

fail() { echo -e "${RED}✗ $*${NC}" >&2; exit 1; }
ok() { echo -e "${GREEN}✓${NC} $*"; }
note() { echo -e "${YELLOW}!${NC} $*"; }
step() { echo -e "\n${CYAN}$*${NC}"; }

PROMOTED_PACKAGE="git@git.1xinternet.de:1x-agents/packages/user-guide.git"
CUSTOM_PACKAGE="git@git.1xinternet.de:1x-agents/packages/custom/user-guide.git"
SKILL=".agent/skills/user-guide"
GUIDE="docs/user-guide"

step "1/5 Checks"
git rev-parse --git-dir > /dev/null 2>&1 || fail "Not a git repository."
REMOTE="$(git remote get-url origin 2>/dev/null)" || fail "No git remote 'origin'."
case "${REMOTE}" in
  *git.1xinternet.de*) ;;
  *) fail "origin is not on git.1xinternet.de (${REMOTE}); GitLab Pages needs the project there." ;;
esac
git ls-remote origin HEAD > /dev/null 2>&1 \
  || fail "GitLab is not reachable over SSH. Connect the VPN and check: ssh -T git@git.1xinternet.de"
ok "GitLab reachable"
[ -f .1xai-manifest.json ] || fail "No .1xai-manifest.json: install 1x-ai in this project first (npx @1xINTERNET/1x-ai@latest)."
command -v npx > /dev/null 2>&1 || fail "npx not found on the host: install Node.js."
ddev drush php:eval "echo 1;" > /dev/null 2>&1 \
  || fail "The local site doesn't run (drush fails). Usually the database belongs to another branch: import a fresh one or run 'ddev drush deploy', then run this again."
ok "Local site runs"
if ! ddev 1x-playwright --version > /dev/null 2>&1 || [ ! -f test/playwright/playwright.config.ts ]; then
  fail "Playwright is not set up: run 'ddev 1x-token-setup' and 'ddev 1x-playwright-install', then run this again."
fi
ok "Playwright set up"

step "2/5 Agents package"
# Prefer the promoted package once it exists; replace a line for the other repo or for a branch.
if git ls-remote "${PROMOTED_PACKAGE}" HEAD > /dev/null 2>&1; then
  PACKAGE="${PROMOTED_PACKAGE}"
else
  PACKAGE="${CUSTOM_PACKAGE}"
fi
CURRENT="$(jq_compat -r --arg p "${PACKAGE}" '.packages[$p] // ""' < .1xai-manifest.json)"
if [ "${CURRENT}" != "HEAD" ]; then
  jq_compat --arg a "${PROMOTED_PACKAGE}" --arg b "${CUSTOM_PACKAGE}" --arg p "${PACKAGE}" \
    '.packages |= (del(.[$a], .[$b]) + {($p): "HEAD"})' < .1xai-manifest.json > .1xai-manifest.json.tmp
  mv .1xai-manifest.json.tmp .1xai-manifest.json
  ok "Added ${PACKAGE} to .1xai-manifest.json"
else
  ok "Package already in .1xai-manifest.json"
fi
npx --yes @1xINTERNET/1x-ai@latest . update > /dev/null
[ -f "${SKILL}/SKILL.md" ] || fail "The user-guide skill was not installed (${SKILL}). Run 'npx @1xINTERNET/1x-ai@latest . update' and check its output."
ok "user-guide skill installed"

step "3/5 Content folder"
# Pages URL from the GitLab path: group/sub/project -> https://group.pages.1xinternet.de/sub/project/
GITLAB_PATH="$(echo "${REMOTE}" | sed -E 's#^(ssh://)?(git@|https://)git\.1xinternet\.de[:/]##; s#\.git$##')"
PAGES_URL="https://${GITLAB_PATH%%/*}.pages.1xinternet.de/${GITLAB_PATH#*/}/"
mkdir -p "${GUIDE}"
if [ ! -f "${GUIDE}/site.config.json" ]; then
  jq_compat -n --arg title "${DDEV_PROJECT} user guide" --arg url "${PAGES_URL}" --arg local "${DDEV_PRIMARY_URL}" \
    '{title: $title, description: "How to work with the website.", url: $url, sites: [{name: "Local", url: $local}]}' \
    > "${GUIDE}/site.config.json"
  ok "Created ${GUIDE}/site.config.json (${PAGES_URL})"
else
  ok "${GUIDE}/site.config.json exists"
fi
if [ ! -f "${GUIDE}/index.md" ]; then
  cat > "${GUIDE}/index.md" <<EOF
---
title: ${DDEV_PROJECT} user guide
description: How to work with the website.
---

This guide explains how to work with the website.
EOF
  ok "Created ${GUIDE}/index.md"
else
  ok "${GUIDE}/index.md exists"
fi
# The preview is now 'ddev 1x-user-guide'; remove the copy the user-guide skill used to manage.
if [ -f .ddev/commands/host/user-guide ] && grep -q "MANAGED FILE" .ddev/commands/host/user-guide; then
  rm .ddev/commands/host/user-guide
  ok "Removed the old .ddev/commands/host/user-guide (now: ddev 1x-user-guide)"
fi

step "4/5 Screenshot runner"
# The runner is a managed copy of the skill's asset; only an older managed version is replaced.
version() { sed -n 's/.*Version \([0-9][0-9]*\)\..*/\1/p' "$1" | head -1; }
ASSETS="${SKILL}/assets/playwright"
if [ ! -f test/playwright/playwright.user-guide.config.ts ]; then
  cp "${ASSETS}/playwright.user-guide.config.ts" test/playwright/
  ok "Added test/playwright/playwright.user-guide.config.ts"
fi
SPEC="test/playwright/user-guide/screenshots.spec.ts"
if [ ! -f "${SPEC}" ]; then
  mkdir -p "$(dirname "${SPEC}")"
  cp "${ASSETS}/user-guide/screenshots.spec.ts" "${SPEC}"
  ok "Added ${SPEC}"
elif head -1 "${SPEC}" | grep -q "MANAGED FILE"; then
  if [ "$(version "${SPEC}")" -lt "$(version "${ASSETS}/user-guide/screenshots.spec.ts")" ]; then
    cp "${ASSETS}/user-guide/screenshots.spec.ts" "${SPEC}"
    ok "Updated ${SPEC}"
  else
    ok "${SPEC} is up to date"
  fi
else
  note "${SPEC} is the project's own script; Claude Code moves its shots into screenshots.json."
fi
ddev 1x-playwright test -c playwright.user-guide.config.ts --pass-with-no-tests > /dev/null \
  || fail "The screenshot runner fails: ddev 1x-playwright test -c playwright.user-guide.config.ts --pass-with-no-tests"
ok "Screenshot runner works"

step "5/5 Build"
ddev 1x-user-guide check > /dev/null || fail "The guide doesn't build: ddev 1x-user-guide check"
ok "Guide builds (ddev 1x-user-guide check)"

step "Open todos for Claude Code"
# Only what is still missing goes into the prompt; everything above is done.
TODOS=()
if ! grep -qs "gitlab-pages.yml" .gitlab-ci.yml; then
  TODOS+=("CI: add the gitlab-pages template to .gitlab-ci.yml (create the file if missing): include project '1xinternet/gitlab-ci-common', file 'gitlab-pages.yml'. Ask me: publish on release tags (what Prod has; only if the project has tags and a tag pipeline) or from one branch, e.g. main (what Stage has) or an MVP branch; for a branch set variables: GITLAB_PAGES_BRANCH. If another job named pages or a docs-ui include already uses the Pages site, ask whether to keep it and only check the guide (GITLAB_PAGES_ENABLED: 'false'). Remove old copied jobs (.user-guide-build, user-guide:check, pages for the guide) and tools/user-guide-site/.")
fi
TODOS+=("Stages: the template's jobs run in stage .post, and GitLab never creates a pipeline with only .pre/.post jobs. Run a lint dry run for the publish ref (glab api -X POST projects/<id>/ci/lint with dry_run, include_jobs, ref). If the pipeline would be empty, the project has no other merge request jobs, or this is its first CI file, override in .gitlab-ci.yml: user-guide:check and pages each get a stage the project defines in stages: (without stages: use test and deploy).")
TODOS+=("GitLab Pages settings (remote changes: name each one and ask first): glab api projects/<id>/pages. If is_unique_domain_enabled is true, ask me to turn it off in GitLab under Deploy > Pages > Use unique domain, then check again. The site is always for project members only: if pages_access_level is not private, set it with glab api -X PUT projects/<id> -f pages_access_level=private. Never make it public, don't ask.")
if ! jq_compat -e '.logo' < "${GUIDE}/site.config.json" > /dev/null 2>&1; then
  TODOS+=("Branding in ${GUIDE}/site.config.json: title '<Project> user guide' with the real project name; logo, favicon and accent from the active frontend theme: an SVG logo with fixed fill colours (not currentColor), the largest PNG favicon, the logo's brand colour as accent. Copy them to ${GUIDE}/assets/ and set logo, favicon, accent. Ask only if there are several real candidates.")
fi
if [ "$(jq_compat '.sites | length' < "${GUIDE}/site.config.json")" -lt 3 ]; then
  TODOS+=("Websites in ${GUIDE}/site.config.json, in this order: Local (already set), Stage (usually https://stage.<project>.de, main branch), Prod (usually https://www.<project>.de, tagged main). Confirm them from docs/STANDARDS.md or the environment urls of the deploy jobs; ask only for what no source confirms. No test environment; Qaack is not a preset.")
fi
if ! grep -qs "End-user documentation" docs/STANDARDS.md; then
  TODOS+=("STANDARDS: add the section 'End-user documentation' to docs/STANDARDS.md with the template in .agent/skills/user-guide/assets/standards-section.md. Ask me for readers, their roles and the language. Pages URL: ${PAGES_URL}, project members only. Preview: ddev 1x-user-guide; check before committing: ddev 1x-user-guide check; screenshots: ddev 1x-playwright test -c playwright.user-guide.config.ts.")
fi
if [ -d test/playwright/tests-examples ] || [ -f test/playwright/tests/example.spec.ts ]; then
  TODOS+=("Delete the Playwright scaffold's demo tests (test/playwright/tests/example.spec.ts, test/playwright/tests-examples/) if they are not tracked by git.")
fi
if [ -z "$(find "${GUIDE}" -name '*.md' ! -name index.md -print -quit)" ]; then
  TODOS+=("First page, with the user-guide skill: ask me which single task a user of the website should be able to do; prefer one that needs a screenshot. Write the page, add it to index.md, take the screenshot with the runner (synthetic user, test content with a fixed UUID), check it for personal data, and give me the preview link (ddev 1x-user-guide).")
fi
TODOS+=("Finish: ddev 1x-user-guide check must end with 'User guide OK'; git status lists only the files of this setup (.claude/settings.json is never committed). Summarise what was done, list the changed files and propose commits. Don't commit, push or open a merge request until I say so.")

PROMPT="ddev 1x-user-guide-install has prepared the end-user guide in this project: the user-guide agents package, ${GUIDE}/ (site.config.json, index.md) and the Playwright screenshot runner; the guide builds. Pages URL: ${PAGES_URL}.

Do the open todos below, in order. Rules: find facts yourself (repo, .ddev/config.yaml, .gitlab-ci.yml, GitLab API with glab, theme files) and ask me only for decisions, in one round where possible. State the blast radius before every step with side effects (local, remote GitLab, Pages site).

Open todos:"
for i in "${!TODOS[@]}"; do
  PROMPT+="
$((i + 1)). ${TODOS[$i]}"
done

echo -e "${GREEN}${#TODOS[@]} todos left for Claude Code.${NC}"
if command -v claude > /dev/null 2>&1; then
  echo "Starting Claude Code; answer its questions there."
  exec claude "${PROMPT}"
fi
note "Claude Code is not installed. Start it in this project and paste:"
echo -e "\n${PROMPT}\n"
