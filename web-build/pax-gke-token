#!/usr/bin/env bash
#ddev-generated
set -euo pipefail
provider=${PAX_WORKFORCE_PROVIDER:-//iam.googleapis.com/locations/global/workforcePools/pax-platform/providers/kubernetes}
project=${PAX_GCP_PROJECT_NUMBER:-548392726325}
cache_base=${PAX_GKE_TOKEN_CACHE:-${HOME}/.kube/cache/pax-gke-token.json}
id_token=$(kubectl-oidc_login get-token --oidc-issuer-url=https://keycloak.backbone.pax.1xinter.net/realms/pax --oidc-client-id=kubernetes "$@" | jq -r .status.token)
[ -n "$id_token" ] && [ "$id_token" != null ] || { echo "no identity token from kubelogin" >&2; exit 1; }
subject=$(printf '%s' "${id_token#*.}" | cut -d. -f1 | tr '_-' '/+' | { p=$(cat); printf '%s%s' "$p" "$(printf '%*s' $(( (4 - ${#p} % 4) % 4 )) '' | tr ' ' '=')"; } | base64 -d 2>/dev/null | jq -r '.sub // empty')
[ -n "$subject" ] || { echo "identity token carries no subject" >&2; exit 1; }
key=$(printf '%s|%s|%s' "$provider" "$project" "$subject" | sha256sum | cut -c1-16)
cache="${cache_base%.json}-${key}.json"
now=$(date -u +%s)
emit() { jq -c '{apiVersion:"client.authentication.k8s.io/v1",kind:"ExecCredential",status:{token:.token,expirationTimestamp:(.expires_at|todate)}}' "$1"; }
if [ -f "$cache" ] && [ "$(jq -r '.subject // empty' "$cache")" = "$subject" ] && [ "$(jq -r '.expires_at // 0' "$cache")" -gt $((now + 120)) ]; then
  emit "$cache"; exit 0
fi
resp=$(curl -sS https://sts.googleapis.com/v1/token \
  --data-urlencode "audience=$provider" \
  --data-urlencode "grant_type=urn:ietf:params:oauth:grant-type:token-exchange" \
  --data-urlencode "requested_token_type=urn:ietf:params:oauth:token-type:access_token" \
  --data-urlencode "scope=https://www.googleapis.com/auth/cloud-platform" \
  --data-urlencode "subject_token_type=urn:ietf:params:oauth:token-type:id_token" \
  --data-urlencode "subject_token=$id_token" \
  --data-urlencode "options={\"userProject\":\"$project\"}")
token=$(jq -r '.access_token // empty' <<<"$resp")
[ -n "$token" ] || { echo "token exchange failed: $(jq -c '.error_description // .' <<<"$resp")" >&2; exit 1; }
ttl=$(jq -r '.expires_in // 3600' <<<"$resp")
mkdir -p "$(dirname "$cache")"
umask 077
jq -n --arg t "$token" --arg s "$subject" --argjson e $((now + ttl)) '{token:$t,subject:$s,expires_at:$e}' > "$cache.$$" && mv -f "$cache.$$" "$cache"
emit "$cache"
